<Page x:Class="AllLive.WinUI.Views.RecomendPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:AllLive.WinUI.Controls" xmlns:viewModels="using:AllLive.WinUI.ViewModels">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <StackPanel Margin="16,12,16,8" Spacing="8">
 <Grid x:Name="BrowseHeader" MinHeight="44"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Padding="4" HorizontalAlignment="Left" CornerRadius="12" Background="{ThemeResource ControlFillColorDefaultBrush}">
 <SelectorBar x:Name="PlatformPicker" HorizontalAlignment="Left" SelectionChanged="PlatformPicker_SelectionChanged" AutomationProperties.Name="直播平台">
 <SelectorBarItem Style="{StaticResource PlatformItemStyle}" Text="哔哩哔哩" Tag="{x:Bind viewModels:MainVM.Sites[0]}"/>
 <SelectorBarItem Style="{StaticResource PlatformItemStyle}" Text="抖音" Tag="{x:Bind viewModels:MainVM.Sites[1]}"/>
 </SelectorBar>
 </Border><Button x:Name="HeaderRefresh" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind recomendVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph="&#xE72C;"/></Button></Grid>
 <StackPanel x:Name="PinnedGamesSection" Visibility="Collapsed" Spacing="4">
 <TextBlock Text="常看游戏" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
 <ListView x:Name="PinnedGamesList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PinnedGamesList_ItemClick" ContainerContentChanging="PinnedGamesList_ContainerContentChanging" Padding="0" AutomationProperties.Name="常看游戏" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
 <ListView.Resources><CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius></ListView.Resources>
 <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="160"/></ItemsPanelTemplate></ListView.ItemsPanel>
 <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,4"/><Setter Property="CornerRadius" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
 <ListView.ItemTemplate><DataTemplate><Border CornerRadius="8" Padding="12,8" BorderThickness="1" BorderBrush="{ThemeResource CardOutlineBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" ToolTipService.ToolTip="{Binding Name}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/></Border></DataTemplate></ListView.ItemTemplate>
 </ListView>
 </StackPanel>
 </StackPanel>
 <controls:MyAdaptiveGridView x:Name="RoomsGrid" Grid.Row="1" Padding="12,4,12,12" CanLoadMore="{x:Bind recomendVM.CanLoadMore, Mode=OneWay}"
 DataLoading="{x:Bind recomendVM.Loading, Mode=OneWay}" DesiredWidth="{StaticResource GridViewDesiredWidth}"
 IsItemClickEnabled="True" ItemClick="MyAdaptiveGridView_ItemClick" ItemHeight="{StaticResource GridViewItemHeight}"
 ItemTemplate="{StaticResource RoomItemTemplate}" ItemsSource="{x:Bind recomendVM.Items, Mode=OneWay}"
 LoadMoreCommand="{x:Bind recomendVM.LoadMoreCommand}" SelectionMode="None">
 <controls:MyAdaptiveGridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource GridViewItemCornerRadiusStyle}">
 <Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/>
 <Setter Property="Background" Value="{ThemeResource ButtonBackground}"/>
 <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 <Setter Property="VerticalContentAlignment" Value="Stretch"/>
 </Style></controls:MyAdaptiveGridView.ItemContainerStyle>
 <controls:MyAdaptiveGridView.Footer><StackPanel HorizontalAlignment="Center">
 <HyperlinkButton Content="加载更多" Command="{x:Bind recomendVM.LoadMoreCommand}" Visibility="{x:Bind recomendVM.CanLoadMore, Mode=OneWay}"/>
 <ProgressRing Width="24" IsActive="True" Visibility="{x:Bind recomendVM.Loading, Mode=OneWay}"/>
 </StackPanel></controls:MyAdaptiveGridView.Footer></controls:MyAdaptiveGridView>
 <TextBlock Grid.Row="1" Text="{x:Bind recomendVM.EmptyMessage, Mode=OneWay}" Margin="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
 Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind recomendVM.IsEmpty, Mode=OneWay}"/>

 </Grid></Page>
