<Page
    x:Class="AllLive.WinUI.Views.FavoritePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Windows10version1809="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 7)"
    xmlns:controls="using:AllLive.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AllLive.WinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AllLive.WinUI.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid x:Name="BrowseHeader" Margin="16,12,16,8" MinHeight="44">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PageTitle" Margin="0,0,8,0" Style="{StaticResource PageTitleStyle}" Text="我的关注"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ManageFavorites" Click="ManageFavorites_Click">管理全部关注</Button>
                <Grid Width="36" Height="36">
                    <Button x:Name="HeaderRefresh" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind favoriteVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新" Visibility="{x:Bind favoriteVM.LoaddingLiveStatus, Mode=OneWay, Converter={StaticResource displayConvert}}"><FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph="&#xE72C;"/></Button>
                    <ProgressRing Width="20" Height="20" IsActive="True" Visibility="{x:Bind favoriteVM.LoaddingLiveStatus, Mode=OneWay}"/>
                </Grid>
                <Button x:Name="FavoriteMore" Style="{StaticResource ToolbarIconStyle}" ToolTipService.ToolTip="更多关注操作" AutomationProperties.Name="更多关注操作">
                    <FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph="&#xE712;"/>
                    <Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem x:Name="ImportFavorites" Text="导入列表" Command="{x:Bind favoriteVM.InputCommand}"/>
                        <MenuFlyoutItem x:Name="ExportFavorites" Text="导出列表" Command="{x:Bind favoriteVM.OutputCommand}"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="FavoriteHelp" Text="使用说明" Command="{x:Bind favoriteVM.TipCommand}"/>
                    </MenuFlyout></Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <controls:MyAdaptiveGridView
                Padding="12,4,12,12"
                CanLoadMore="False"
                DesiredWidth="400"
                IsItemClickEnabled="True"
                ItemClick="ls_ItemClick"
                ItemHeight="72"
                ItemsSource="{x:Bind Path=favoriteVM.Items, Mode=OneWay}"
                SelectionMode="None">
                <controls:MyAdaptiveGridView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource GridViewItemCornerRadiusStyle}" TargetType="GridViewItem">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                    </Style>
                </controls:MyAdaptiveGridView.ItemContainerStyle>
                <controls:MyAdaptiveGridView.ItemTemplate>
                    <DataTemplate x:DataType="models:FavoriteItem">
                        <Grid>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="MenuFlyoutItem_Click"
                                        Icon="Delete"
                                        Text="移除" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <PersonPicture
                                Width="56"
                                Height="48"
                                Background="Blue"
                                BorderThickness="0"
                                ProfilePicture="{x:Bind Path=Photo}" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Path=UserName}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Path=SiteName}" />
                            </StackPanel>
                            <StackPanel
                                Grid.ColumnSpan="2"
                                Margin="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{x:Bind Path=LiveStatus, Mode=OneWay}">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Fill="Green" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="Green"
                                    Text="直播中"
                                    Visibility="{x:Bind Path=LiveStatus, Mode=OneWay}" />
                            </StackPanel>

                        </Grid>
                    </DataTemplate>
                </controls:MyAdaptiveGridView.ItemTemplate>
            </controls:MyAdaptiveGridView>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{x:Bind Path=favoriteVM.IsEmpty, Mode=OneWay}">
                <Run Text="{x:Bind favoriteVM.EmptyMessage, Mode=OneWay}"/>
            </TextBlock>


        </Grid>
    </Grid>
</Page>
