<?xml version="1.0" ?><Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:PlayWin.WinUI.Controls" xmlns:viewModels="using:PlayWin.WinUI.ViewModels" x:Class="PlayWin.WinUI.Views.RecomendPage" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14" Foreground="{ThemeResource AppTextBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <StackPanel Margin="20,16,20,8" Spacing="8">
 <Grid x:Name="BrowseHeader" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Padding="4" HorizontalAlignment="Left" CornerRadius="14" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1">
 <ListView x:Name="PlatformPicker" Padding="0" ItemsSource="{x:Bind viewModels:MainVM.Sites}" SelectionChanged="PlatformPicker_SelectionChanged" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False" HorizontalAlignment="Left" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ItemContainerStyle="{StaticResource PlatformTabStyle}" AutomationProperties.Name="直播平台">
 <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="96" ItemHeight="44"/></ItemsPanelTemplate></ListView.ItemsPanel>
 <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="14" Margin="0,-1,0,1" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="20" FontFamily="{StaticResource NavigationFontFamily}"/></DataTemplate></ListView.ItemTemplate>
 </ListView>
 </Border><Button x:Name="HeaderRefresh" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind recomendVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph=""/></Button></Grid>
 <StackPanel x:Name="PinnedGamesSection" Visibility="Collapsed" Spacing="4">
 <TextBlock Text="常看游戏" FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}"/>
 <ListView x:Name="PinnedGamesList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PinnedGamesList_ItemClick" ContainerContentChanging="PinnedGamesList_ContainerContentChanging" Padding="0" AutomationProperties.Name="常看游戏" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
 <ListView.Resources><CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius></ListView.Resources>
 <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="160"/></ItemsPanelTemplate></ListView.ItemsPanel>
 <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,4"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
 <ListView.ItemTemplate><DataTemplate><Border CornerRadius="10" Padding="12,8" BorderThickness="1" BorderBrush="{ThemeResource CardOutlineBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" ToolTipService.ToolTip="{Binding Name}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/></Border></DataTemplate></ListView.ItemTemplate>
 </ListView>
 </StackPanel>
 </StackPanel>
 <controls:MyAdaptiveGridView x:Name="RoomsGrid" Grid.Row="1" Padding="16,4,16,16" CanLoadMore="{x:Bind recomendVM.CanLoadMore, Mode=OneWay}" DataLoading="{x:Bind recomendVM.Loading, Mode=OneWay}" DesiredWidth="{StaticResource GridViewDesiredWidth}" IsItemClickEnabled="True" ItemClick="MyAdaptiveGridView_ItemClick" ItemHeight="{StaticResource GridViewItemHeight}" ItemTemplate="{StaticResource RoomItemTemplate}" ItemsSource="{x:Bind recomendVM.Items, Mode=OneWay}" LoadMoreCommand="{x:Bind recomendVM.LoadMoreCommand}" SelectionMode="None">
 <controls:MyAdaptiveGridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource GridViewItemCornerRadiusStyle}">
 <Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/>
 <Setter Property="Background" Value="{ThemeResource ButtonBackground}"/>
 <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 <Setter Property="VerticalContentAlignment" Value="Stretch"/>
 </Style></controls:MyAdaptiveGridView.ItemContainerStyle>
 <controls:MyAdaptiveGridView.Footer><StackPanel HorizontalAlignment="Center">
 <HyperlinkButton Content="加载更多" Command="{x:Bind recomendVM.LoadMoreCommand}" Visibility="{x:Bind recomendVM.CanLoadMore, Mode=OneWay}"/>
 <ProgressRing Width="24" IsActive="True" Visibility="{x:Bind recomendVM.Loading, Mode=OneWay}"/>
 </StackPanel></controls:MyAdaptiveGridView.Footer></controls:MyAdaptiveGridView>
 <TextBlock Grid.Row="1" Text="{x:Bind recomendVM.EmptyMessage, Mode=OneWay}" Margin="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Visibility="{x:Bind recomendVM.IsEmpty, Mode=OneWay}"/>

 </Grid></Page>