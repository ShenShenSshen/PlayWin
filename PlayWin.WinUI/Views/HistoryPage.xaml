<Page
    x:Class="PlayWin.WinUI.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Windows10version1809="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 7)"
    xmlns:controls="using:PlayWin.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PlayWin.WinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PlayWin.WinUI.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid x:Name="BrowseHeader" Margin="16,12,16,8" MinHeight="44">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PageTitle" Margin="0,0,8,0" Style="{StaticResource PageTitleStyle}" Text="观看历史"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind historyVM.CleanCommand}" ToolTipService.ToolTip="清空历史" AutomationProperties.Name="清空历史" Visibility="{x:Bind historyVM.Loading, Mode=OneWay, Converter={StaticResource displayConvert}}"><SymbolIcon Symbol="Delete"/></Button>
                <Button x:Name="HeaderRefresh" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind historyVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新" Visibility="{x:Bind historyVM.Loading, Mode=OneWay, Converter={StaticResource displayConvert}}"><FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph="&#xE72C;"/></Button>
            </StackPanel>
        </Grid>
        <controls:MyAdaptiveGridView Grid.Row="1"
            Padding="12,4,12,12"
            CanLoadMore="False"
            DesiredWidth="400"
            IsItemClickEnabled="True"
            ItemClick="ls_ItemClick"
            ItemHeight="72"
            ItemsSource="{x:Bind Path=historyVM.Items}"
            SelectionMode="None">
            <controls:MyAdaptiveGridView.ItemContainerStyle>
                <Style BasedOn="{StaticResource GridViewItemCornerRadiusStyle}" TargetType="GridViewItem">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </controls:MyAdaptiveGridView.ItemContainerStyle>
            <controls:MyAdaptiveGridView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryItem">
                    <Grid>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="MenuFlyoutItem_Click"
                                    Icon="Delete"
                                    Text="移除" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <PersonPicture
                            Width="56"
                            Height="48"
                            Background="Blue"
                            BorderThickness="0"
                            ProfilePicture="{x:Bind Path=Photo}" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Path=UserName}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="13"
                                Foreground="{ThemeResource ReadableSecondaryTextBrush}">
                                观看于<Run Text="{x:Bind Path=WatchTime}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </controls:MyAdaptiveGridView.ItemTemplate>
        </controls:MyAdaptiveGridView>
        <TextBlock Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource ReadableSecondaryTextBrush}"
            Visibility="{x:Bind Path=historyVM.IsEmpty, Mode=OneWay}">
            这里还什么都没有~
        </TextBlock>

    </Grid>
</Page>
