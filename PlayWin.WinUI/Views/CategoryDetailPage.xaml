<Page x:Class="PlayWin.WinUI.Views.CategoryDetailPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:PlayWin.WinUI.Controls">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <Grid x:Name="BrowseHeader" Margin="16,12,16,8" MinHeight="44"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageTitle" Margin="0,0,8,0" Style="{StaticResource PageTitleStyle}" Text="{x:Bind categoryDetailVM.Category.Name, Mode=OneWay}"/><Button x:Name="HeaderRefresh" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind categoryDetailVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph="&#xE72C;"/></Button></Grid>
 <controls:MyAdaptiveGridView Grid.Row="1" Padding="12,4,12,12" CanLoadMore="{x:Bind categoryDetailVM.CanLoadMore, Mode=OneWay}"
 DataLoading="{x:Bind categoryDetailVM.Loading, Mode=OneWay}" DesiredWidth="{StaticResource GridViewDesiredWidth}"
 IsItemClickEnabled="True" ItemClick="MyAdaptiveGridView_ItemClick" ItemHeight="{StaticResource GridViewItemHeight}"
 ItemTemplate="{StaticResource RoomItemTemplate}" ItemsSource="{x:Bind categoryDetailVM.Items, Mode=OneWay}"
 LoadMoreCommand="{x:Bind categoryDetailVM.LoadMoreCommand}" SelectionMode="None">
 <controls:MyAdaptiveGridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource GridViewItemCornerRadiusStyle}">
 <Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/>
 <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
 <Setter Property="Background" Value="{ThemeResource ButtonBackground}"/>
 <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 <Setter Property="VerticalContentAlignment" Value="Stretch"/>
 </Style></controls:MyAdaptiveGridView.ItemContainerStyle>
 <controls:MyAdaptiveGridView.Footer><StackPanel HorizontalAlignment="Center">
 <HyperlinkButton Content="加载更多" Command="{x:Bind categoryDetailVM.LoadMoreCommand}" Visibility="{x:Bind categoryDetailVM.CanLoadMore, Mode=OneWay}"/>
 <ProgressRing Width="24" IsActive="True" Visibility="{x:Bind categoryDetailVM.Loading, Mode=OneWay}"/>
 </StackPanel></controls:MyAdaptiveGridView.Footer></controls:MyAdaptiveGridView>
 <TextBlock Grid.Row="1" Text="{x:Bind categoryDetailVM.EmptyMessage, Mode=OneWay}" Margin="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
 Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind categoryDetailVM.IsEmpty, Mode=OneWay}"/>

 </Grid></Page>
