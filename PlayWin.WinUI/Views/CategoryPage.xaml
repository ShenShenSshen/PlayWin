<?xml version="1.0" ?><Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:PlayWin.Core.Models" xmlns:viewModels="using:PlayWin.WinUI.ViewModels" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives" x:Class="PlayWin.WinUI.Views.CategoryPage" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14" Foreground="{ThemeResource AppTextBrush}">
 <Page.Resources>
 <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
 <Style x:Key="GameGroupItemStyle" TargetType="ListViewItem">
 <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,6"/><Setter Property="MinWidth" Value="80"/><Setter Property="MinHeight" Value="36"/>
 <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
 <primitives:ListViewItemPresenter CornerRadius="{TemplateBinding CornerRadius}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentMargin="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}" Background="Transparent" SelectedBackground="{ThemeResource CategorySelectedBrush}" SelectedPointerOverBackground="{ThemeResource AppSelectionHoverBrush}" SelectedPressedBackground="{ThemeResource CategorySelectedBrush}" SelectedForeground="{ThemeResource CategorySelectedForegroundBrush}" PointerOverBackground="{ThemeResource AppHoverBrush}" PressedBackground="{ThemeResource AppPressedBrush}" FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}" FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"/>
 </ControlTemplate></Setter.Value></Setter>
 <Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="{StaticResource NavigationFontFamily}"/></Style>
 </Page.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <StackPanel Margin="20,16,20,8" Spacing="12">
 <Grid x:Name="BrowseHeader" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Padding="4" HorizontalAlignment="Left" CornerRadius="14" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1">
 <ListView x:Name="PlatformPicker" Padding="0" ItemsSource="{x:Bind viewModels:MainVM.Sites}" SelectionChanged="PlatformPicker_SelectionChanged" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False" HorizontalAlignment="Left" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ItemContainerStyle="{StaticResource PlatformTabStyle}" AutomationProperties.Name="直播平台">
 <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="96" ItemHeight="44"/></ItemsPanelTemplate></ListView.ItemsPanel>
 <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="14" Margin="0,-1,0,1" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="20" FontFamily="{StaticResource NavigationFontFamily}"/></DataTemplate></ListView.ItemTemplate>
 </ListView>
 </Border><Button x:Name="HeaderRefresh" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind categoryVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph=""/></Button></Grid>
 <ListView x:Name="GroupPicker" Padding="0" ItemsSource="{x:Bind categoryVM.Groups}" SelectedItem="{x:Bind categoryVM.SelectedGroup, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="游戏大类" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource GameGroupItemStyle}">
 <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="112"/></ItemsPanelTemplate></ListView.ItemsPanel>
 <ListView.ItemTemplate><DataTemplate x:DataType="models:LiveCategory"><TextBlock Margin="0,-1,0,1" VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="None" TextWrapping="Wrap" TextAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" FontSize="14" LineHeight="20"/></DataTemplate></ListView.ItemTemplate>
 </ListView>
 </StackPanel>
 <GridView x:Name="GamesGrid" Grid.Row="1" Padding="16,4,16,16" ItemsSource="{x:Bind categoryVM.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GridView_ItemClick" ContainerContentChanging="GamesGrid_ContainerContentChanging">
 <GridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource GridViewItemCornerRadiusStyle}">
 <Setter Property="Width" Value="160"/><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4"/><Setter Property="CornerRadius" Value="10"/>
 <Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
 </Style></GridView.ItemContainerStyle>
 <GridView.ItemTemplate><DataTemplate x:DataType="models:LiveGameCategory"><Border CornerRadius="10" Padding="14,12" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardOutlineBrush}" BorderThickness="1" ToolTipService.ToolTip="{x:Bind Name}">
 <TextBlock Text="{x:Bind Name}" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
 </Border></DataTemplate></GridView.ItemTemplate></GridView>
 <ProgressRing Grid.Row="1" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind categoryVM.Loading, Mode=OneWay}"/>
 <TextBlock Grid.Row="1" Text="{x:Bind categoryVM.EmptyMessage, Mode=OneWay}" Margin="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind categoryVM.IsEmpty, Mode=OneWay}"/>

 </Grid></Page>