<Page x:Class="PlayWin.WinUI.Views.CategoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:PlayWin.Core.Models" xmlns:viewModels="using:PlayWin.WinUI.ViewModels" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
 <Page.Resources>
 <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
 <Style x:Key="GameGroupItemStyle" TargetType="ListViewItem">
 <Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,4"/><Setter Property="MinWidth" Value="80"/><Setter Property="MinHeight" Value="36"/>
 <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
 <primitives:ListViewItemPresenter CornerRadius="{TemplateBinding CornerRadius}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentMargin="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}" Background="Transparent"
 SelectedBackground="{ThemeResource CategorySelectedBrush}" SelectedPointerOverBackground="{ThemeResource CategorySelectedBrush}" SelectedPressedBackground="{ThemeResource CategorySelectedBrush}" SelectedForeground="{ThemeResource CategorySelectedForegroundBrush}"
 PointerOverBackground="{ThemeResource ControlFillColorSecondaryBrush}" PressedBackground="{ThemeResource ControlFillColorTertiaryBrush}" FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}" FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"/>
 </ControlTemplate></Setter.Value></Setter>
 </Style>
 </Page.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <StackPanel Margin="16,12,16,8" Spacing="12">
 <Grid x:Name="BrowseHeader" MinHeight="44"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Padding="4" HorizontalAlignment="Left" CornerRadius="12" Background="{ThemeResource ControlFillColorDefaultBrush}">
 <SelectorBar x:Name="PlatformPicker" HorizontalAlignment="Left" SelectionChanged="PlatformPicker_SelectionChanged" AutomationProperties.Name="直播平台">
 <SelectorBarItem Style="{StaticResource PlatformItemStyle}" Text="哔哩哔哩" Tag="{x:Bind viewModels:MainVM.Sites[0]}"/>
 <SelectorBarItem Style="{StaticResource PlatformItemStyle}" Text="抖音" Tag="{x:Bind viewModels:MainVM.Sites[1]}"/>
 </SelectorBar>
 </Border><Button x:Name="HeaderRefresh" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind categoryVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph="&#xE72C;"/></Button></Grid>
 <ListView x:Name="GroupPicker" Padding="0" ItemsSource="{x:Bind categoryVM.Groups}" SelectedItem="{x:Bind categoryVM.SelectedGroup, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="游戏大类" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource GameGroupItemStyle}">
 <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="112" /></ItemsPanelTemplate></ListView.ItemsPanel>
 <ListView.ItemTemplate><DataTemplate x:DataType="models:LiveCategory"><TextBlock Text="{x:Bind Name}" TextTrimming="None" TextWrapping="Wrap" TextAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}"/></DataTemplate></ListView.ItemTemplate>
 </ListView>
 </StackPanel>
 <GridView x:Name="GamesGrid" Grid.Row="1" Padding="12,4,12,12" ItemsSource="{x:Bind categoryVM.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GridView_ItemClick" ContainerContentChanging="GamesGrid_ContainerContentChanging">
 <GridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource GridViewItemCornerRadiusStyle}">
 <Setter Property="Width" Value="160"/><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4"/><Setter Property="CornerRadius" Value="8"/>
 <Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
 </Style></GridView.ItemContainerStyle>
 <GridView.ItemTemplate><DataTemplate x:DataType="models:LiveGameCategory"><Border CornerRadius="8" Padding="12,10" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardOutlineBrush}" BorderThickness="1" ToolTipService.ToolTip="{x:Bind Name}">
 <TextBlock Text="{x:Bind Name}" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
 </Border></DataTemplate></GridView.ItemTemplate></GridView>
 <ProgressRing Grid.Row="1" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind categoryVM.Loading, Mode=OneWay}"/>
 <TextBlock Grid.Row="1" Text="{x:Bind categoryVM.EmptyMessage, Mode=OneWay}" Margin="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind categoryVM.IsEmpty, Mode=OneWay}"/>

 </Grid></Page>
