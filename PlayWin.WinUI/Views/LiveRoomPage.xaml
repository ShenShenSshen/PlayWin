<Page
    x:Class="PlayWin.WinUI.Views.LiveRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="using:PlayWin.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PlayWin.WinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PlayWin.Core.Models"
    xmlns:mvvm="using:PlayWin.WinUI.ViewModels"
    xmlns:my="using:Microsoft.UI.Xaml.Controls"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls"

    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="TitleBar"
                Grid.Column="1"
                Height="32"
                Background="{ThemeResource ChromeSurfaceBrush}"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Image
                    x:Name="AppIcon"
                    Grid.Column="1"
                    Width="18"
                    Height="18"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Source="{x:Bind Path=liveRoomVM.SiteLogo, Mode=OneWay}" />
                <Grid Grid.Column="2" Margin="0,0,138,0" Background="#00FFFFFF">
                    <TextBlock
                        x:Name="Title"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource ContentControlThemeFontFamily}"
                        FontSize="14"
                        FontWeight="Normal"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                        <Run Text="{x:Bind Path=liveRoomVM.Title, Mode=OneWay}" />
                        <Run Text=" - " />
                        <Run Text="{x:Bind Path=liveRoomVM.Name, Mode=OneWay}" />
                    </TextBlock>
                </Grid>

            </Grid>
        </Grid>
        <Grid x:Name="GridContent" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition x:Name="BottomInfo" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BtnFoucs"
                Width="0"
                Height="0"
                Margin="-8,-8,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0" />

                <Grid
                    SizeChanged="PlayerGrid_SizeChanged"
                    Background="Black"
                    DoubleTapped="Grid_DoubleTapped"
                    ManipulationCompleted="Grid_ManipulationCompleted"
                    ManipulationDelta="Grid_ManipulationDelta"
                    ManipulationMode="TranslateY,TranslateRailsY"
                    ManipulationStarted="Grid_ManipulationStarted"
                    PointerEntered="Grid_PointerEntered"
                    PointerExited="Grid_PointerExited"
                    PointerMoved="Grid_PointerMoved"
                    PointerWheelChanged="Grid_PointerWheelChanged"
                    RequestedTheme="Dark">
                    <Grid.ContextFlyout>
                        <Flyout>
                            <TextBlock
                                x:Name="txtInfo"
                                MaxWidth="400"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </Flyout>
                    </Grid.ContextFlyout>
                    <MediaPlayerElement x:Name="player" Stretch="Uniform" />
                    <!--  亮度  -->
                    <Grid
                        x:Name="BrightnessShield"
                        Background="#99000000"
                        Opacity="0"
                        Tapped="Grid_Tapped" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="{ThemeResource ReadableSecondaryTextBrush}"
                        Visibility="{x:Bind Path=liveRoomVM.Living, Mode=OneWay, Converter={StaticResource displayConvert}}">
                        暂未开播
                    </TextBlock>
                    <StackPanel
                        x:Name="PlayerLoading"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <ProgressRing
                            Width="56"
                            Height="56"
                            IsActive="True" />
                        <TextBlock
                            x:Name="PlayerLoadText"
                            Margin="0,8"
                            Foreground="{ThemeResource ReadableSecondaryTextBrush}"
                            TextAlignment="Center">
                            加载中
                        </TextBlock>
                    </StackPanel>
                    <StackPanel x:Name="PlaybackFailure" MaxWidth="460" Margin="16" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="PlaybackFailureText" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button Content="重新播放" HorizontalAlignment="Center" Click="BottomBtnRefresh_Click"/>
                    </StackPanel>
                    <Border
                        x:Name="ToolTip"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#CCFFFFFF"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="TxtToolTip"
                            FontSize="20"
                            Foreground="Black"
                            Text="" />
                    </Border>
                    <Grid x:Name="control">

                        <Grid x:Name="StandardControl">
                            <Grid MinHeight="48" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="0" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.Background>
                                    <StaticResource ResourceKey="PlayerControlsBrush" />
                                </Grid.Background>
                                <StackPanel Orientation="Horizontal">

                                    <Button
                                        x:Name="PlayBtnPlay"
                                        Width="48"
                                        Height="48"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="PlayBtnPlay_Click"
                                        ToolTipService.ToolTip="播放">
                                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE102;" />
                                    </Button>
                                    <Button
                                        x:Name="PlayBtnPause"
                                        Width="48"
                                        Height="48"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="PlayBtnPause_Click"
                                        ToolTipService.ToolTip="暂停"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE103;" />
                                    </Button>

                                </StackPanel>

                                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        x:Name="PlayBtnVolume"
                                        Width="48"
                                        Height="48"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTipService.ToolTip="音量">
                                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE15D;" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel>
                                                    <TextBlock>音量</TextBlock>
                                                    <Slider
                                                        x:Name="SliderVolume"
                                                        Width="200"
                                                        Maximum="1"
                                                        Minimum="0"
                                                        StepFrequency="0.1"
                                                        Value="1" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <ComboBox
                                        x:Name="PlayQuality"
                                        MinWidth="80"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        DisplayMemberPath="Quality"
                                        FontSize="16"
                                        Foreground="White"
                                        ItemsSource="{x:Bind Path=liveRoomVM.Qualities, Mode=OneWay}"
                                        SelectedItem="{x:Bind Path=liveRoomVM.CurrentQuality, Mode=TwoWay}"
                                        ToolTipService.ToolTip="清晰度" />
                                    <ComboBox
                                        x:Name="PlayLine"
                                        MinWidth="80"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        DisplayMemberPath="Name"
                                        FontSize="16"
                                        Foreground="White"
                                        ItemsSource="{x:Bind Path=liveRoomVM.Lines, Mode=OneWay}"
                                        SelectedItem="{x:Bind Path=liveRoomVM.CurrentLine, Mode=TwoWay}"
                                        ToolTipService.ToolTip="线路" />
                                    <Button
                                        x:Name="PlayBtnMinWindow"
                                        Width="48"
                                        Height="48"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="PlayBtnMinWindow_Click"
                                        ToolTipService.ToolTip="小窗">
                                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE17C;" />
                                    </Button>
                                    <Button
                                        x:Name="PlayBtnFullWindow"
                                        Width="48"
                                        Height="48"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="PlayBtnFullWindow_Click"
                                        ToolTipService.ToolTip="铺满窗口">
                                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE9A6;" />
                                    </Button>
                                    <Button
                                        x:Name="PlayBtnExitFullWindow"
                                        Width="48"
                                        Height="48"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="PlayBtnExitFullWindow_Click"
                                        ToolTipService.ToolTip="取消铺满窗口"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE146;" />
                                    </Button>
                                    <Button
                                        x:Name="PlayBtnFullScreen"
                                        Width="48"
                                        Height="48"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="PlayBtnFullScreen_Click"
                                        ToolTipService.ToolTip="全屏">
                                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE1D9;" />
                                    </Button>
                                    <Button
                                        x:Name="PlayBtnExitFullScreen"
                                        Width="48"
                                        Height="48"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="PlayBtnExitFullScreen_Click"
                                        ToolTipService.ToolTip="退出全屏"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE1D8;" />
                                    </Button>
                                </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                        <Grid
                            x:Name="MiniControl"
                            VerticalAlignment="Bottom"
                            Visibility="Collapsed">
                            <Grid.Background>
                                <StaticResource ResourceKey="PlayerControlsBrush" />
                            </Grid.Background>
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                                <HyperlinkButton
                                    Width="48"
                                    Height="48"
                                    Padding="8"
                                    Foreground="White"
                                    Visibility="{Binding ElementName=PlayBtnPause, Path=Visibility, Mode=OneWay}">
                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource ResourceKey=IconPause}" />
                                </HyperlinkButton>
                                <HyperlinkButton
                                    Width="48"
                                    Height="48"
                                    Padding="8"
                                    Foreground="White"
                                    Visibility="{Binding ElementName=PlayBtnPlay, Path=Visibility, Mode=OneWay}">
                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource ResourceKey=IconPlay}" />
                                </HyperlinkButton>

                            </StackPanel>
                            <HyperlinkButton
                                x:Name="BottomBtnExitMiniWindows"
                                Width="48"
                                Height="48"
                                Padding="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Click="BottomBtnExitMiniWindows_Click"
                                Foreground="White"
                                ToolTipService.ToolTip="恢复窗口">
                                <PathIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource ResourceKey=IconFullWindow}" />
                            </HyperlinkButton>
                        </Grid>

                    </Grid>

                </Grid>


            <Grid Grid.Row="1" Background="{ThemeResource ChromeSurfaceBrush}">
                <CommandBar x:Name="RoomCommandBar" Background="Transparent" HorizontalAlignment="Stretch" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
                    <CommandBar.PrimaryCommands>
                    <AppBarButton
                        x:Name="BottomBtnAddFavorite"
                        Command="{x:Bind Path=liveRoomVM.AddFavoriteCommand}"
                        Label="关注"
                        Visibility="{x:Bind Path=liveRoomVM.IsFavorite, Mode=OneWay, Converter={StaticResource displayConvert}}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xEB51;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="BottomBtnRemoveFavorite"
                        Command="{x:Bind Path=liveRoomVM.RemoveFavoriteCommand}"
                        Label="已关注"
                        Visibility="{x:Bind Path=liveRoomVM.IsFavorite, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xEB52;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="BottomBtnRefresh"
                        Click="BottomBtnRefresh_Click"
                        Label="刷新">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE72C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    </CommandBar.PrimaryCommands>
                    <CommandBar.SecondaryCommands>
                    <AppBarButton
                        x:Name="PlayTopBtnScreenshot"
                        BorderThickness="0"
                        Click="PlayTopBtnScreenshot_Click"
                        Label="截图">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE722;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                <AppBarButton
                        x:Name="BottomBtnShare"
                        Click="BottomBtnShare_Click"
                        Label="分享">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE72D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="BottomBtnOpenBrowser"
                        Click="BottomBtnOpenBrowser_Click"
                        Label="浏览器">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xEB41;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="BottomBtnPlayUrl"
                        Click="BottomBtnPlayUrl_Click"
                        Label="直链">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE167;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Grid>

            <ProgressRing
                Grid.ColumnSpan="2"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True"
                Visibility="{x:Bind Path=liveRoomVM.Loading, Mode=OneWay}" />
        </Grid>
    </Grid>

</Page>
