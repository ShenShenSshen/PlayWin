<?xml version="1.0" ?><Page x:Class="PlayWin.WinUI.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="using:PlayWin.WinUI.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:my="using:Microsoft.UI.Xaml.Controls" mc:Ignorable="d" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14" Foreground="{ThemeResource AppTextBrush}">
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>
    <Grid>
        <ScrollViewer>
            <Grid Margin="20,16,20,20" HorizontalAlignment="Stretch">
                <StackPanel x:Name="SettingsCards" MaxWidth="1040" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="PageTitle" Margin="0,0,0,16" Style="{StaticResource PageTitleStyle}" Text="设置"/>
                    <TextBlock Margin="0,0,0,10" FontSize="16" FontWeight="Normal" FontFamily="{StaticResource NavigationFontFamily}">常规</TextBlock>
                    <Border x:Name="SettingsGeneralGroup" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardOutlineBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                    <Grid Padding="18,14" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock>播放区域尺寸</TextBlock>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource ReadableSecondaryTextBrush}">视频区域保持 16:9；窗口另加工具栏高度，屏幕不足时等比例缩小</TextBlock>
                        </StackPanel>
                        <ComboBox x:Name="cbWindowSize" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14"/>
                    </Grid>
                    <Grid Padding="18,14" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock>显示模式</TextBlock>
                            <TextBlock FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}">切换深色与浅色模式</TextBlock>
                        </StackPanel>
                        <ComboBox x:Name="cbTheme" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14">
                            <ComboBox.Items>
                                <ComboBoxItem>跟随系统</ComboBoxItem>
                                <ComboBoxItem>浅色</ComboBoxItem>
                                <ComboBoxItem>深色</ComboBoxItem>
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>

                    <Grid x:Name="SettingsPaneDiaplsyMode" Padding="18,14" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock>导航栏位置</TextBlock>
                            <TextBlock FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}">首页导航栏位置</TextBlock>
                        </StackPanel>
                        <ComboBox x:Name="cbPaneDisplayMode" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14">
                            <ComboBox.Items>
                                <ComboBoxItem>左侧</ComboBoxItem>
                                <ComboBoxItem>顶部</ComboBoxItem>
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="SettingsMouseClosePage" Padding="18,14" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock>鼠标侧键返回</TextBlock>
                            <TextBlock FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}">按鼠标侧键返回上一页</TextBlock>
                        </StackPanel>
                        <ToggleSwitch x:Name="swMouseClosePage" MinWidth="72" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>


                    </StackPanel>
                    </Border>
                    <TextBlock Margin="0,20,0,10" FontSize="16" FontWeight="Normal" FontFamily="{StaticResource NavigationFontFamily}">播放</TextBlock>
                    <Border x:Name="SettingsPlaybackGroup" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardOutlineBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                    <Grid x:Name="SettingsNewWindow" Padding="18,14" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock>新窗口播放</TextBlock>
                            <TextBlock FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}">使用新窗口打开直播间</TextBlock>
                        </StackPanel>
                        <ToggleSwitch x:Name="swNewWindow" MinWidth="72" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Padding="18,14" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock>视频解码器</TextBlock>
                            <TextBlock FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}">播放失败可尝试修改此选项</TextBlock>
                        </StackPanel>
                        <ComboBox x:Name="cbDecoder" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="14">
                            <ComboBox.Items>
                                <ComboBoxItem>自动</ComboBoxItem>
                                <ComboBoxItem>硬件解码</ComboBoxItem>
                                <ComboBoxItem>软件解码</ComboBoxItem>
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>

                    </StackPanel>
                    </Border>
                    <TextBlock Margin="0,20,0,10" FontSize="16" FontWeight="Normal" FontFamily="{StaticResource NavigationFontFamily}">账号</TextBlock>
                    <Border x:Name="SettingsAccountsGroup" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardOutlineBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                    <Grid Padding="18,14" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="36" Height="36" Margin="0,0,12,0" Source="/Assets/Logo/bilibili.png"/>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock>哔哩哔哩</TextBlock>
                                <TextBlock x:Name="txtBili" FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}">
                                    登录后可享受高清直播
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="BtnLoginBili" HorizontalAlignment="Right" Click="BtnLoginBili_Click" Style="{StaticResource PageActionButtonStyle}">
                            立即登录
                        </Button>
                        <Button x:Name="BtnLogoutBili" HorizontalAlignment="Right" Click="BtnLogoutBili_Click" Visibility="Collapsed" Style="{StaticResource PageActionButtonStyle}">
                            注销登录
                        </Button>
                    </Grid>

                    <Grid Padding="18,14" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="36" Height="36" Margin="0,0,12,0" Source="/Assets/Logo/douyin.png"/>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock>抖音</TextBlock>
                                <TextBlock x:Name="txtDouyin" FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Text="未登录，可浏览游戏直播"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="BtnLoginDouyin" HorizontalAlignment="Right" Click="BtnLoginDouyin_Click" Style="{StaticResource PageActionButtonStyle}">立即登录</Button>
                        <Button x:Name="BtnLogoutDouyin" HorizontalAlignment="Right" Click="BtnLogoutDouyin_Click" Visibility="Collapsed" Style="{StaticResource PageActionButtonStyle}">注销登录</Button>
                    </Grid>

                    <Grid x:Name="SettingsHuya" Padding="16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Width="36" Height="36" Margin="0,0,12,0" Source="/Assets/Logo/huya.png"/><StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="虎牙"/><TextBlock x:Name="txtHuya" Text="未登录，可浏览游戏直播" FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="BtnLoginHuya" Content="登录虎牙" Tag="Huya" Click="BtnLoginWeb_Click" Style="{StaticResource PageActionButtonStyle}"/><Button x:Name="BtnLogoutHuya" Content="注销登录" Tag="Huya" Click="BtnLogoutWeb_Click" Visibility="Collapsed" Style="{StaticResource PageActionButtonStyle}"/></StackPanel>
                            </Grid>
                    <Grid x:Name="SettingsDouyu" Padding="16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Width="36" Height="36" Margin="0,0,12,0" Source="/Assets/Logo/douyu.png"/><StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="斗鱼"/><TextBlock x:Name="txtDouyu" Text="未登录，可浏览游戏直播" FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="BtnLoginDouyu" Content="登录斗鱼" Tag="Douyu" Click="BtnLoginWeb_Click" Style="{StaticResource PageActionButtonStyle}"/><Button x:Name="BtnLogoutDouyu" Content="注销登录" Tag="Douyu" Click="BtnLogoutWeb_Click" Visibility="Collapsed" Style="{StaticResource PageActionButtonStyle}"/></StackPanel>
                            </Grid>
                    </StackPanel>
                    </Border>
                    <TextBlock Margin="0,20,0,10" FontSize="16" FontWeight="Normal" FontFamily="{StaticResource NavigationFontFamily}">关于</TextBlock>
                    <Border x:Name="SettingsAboutGroup" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardOutlineBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                    <Grid Padding="18,14" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="AboutAppName" FontFamily="{StaticResource BrandFontFamily}" FontSize="18" FontWeight="Normal" Text="{StaticResource AppDisplayName}"/>
                            <TextBlock FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Text="界面字体：微软雅黑 UI"/>
                            <TextBlock FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Text="PlayWin"/>
                            <TextBlock FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}">
                                版本:<Run x:Name="version"/></TextBlock>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button x:Name="BtnLog" Margin="8,0" Click="BtnLog_Click" Style="{StaticResource PageActionButtonStyle}">
                                运行日志
                            </Button>
                            <Button x:Name="BtnGithub" Click="BtnGithub_Click" Style="{StaticResource PageActionButtonStyle}">项目主页</Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SettingsUpdate" Padding="18,14" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="软件更新"/>
                            <TextBlock FontSize="13" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Text="{x:Bind updateVM.Status, Mode=OneWay}"/>
                            <ProgressBar x:Name="UpdateProgress" Height="4" Maximum="100" Value="{x:Bind updateVM.Progress, Mode=OneWay}" Visibility="{x:Bind updateVM.HideProgress, Mode=OneWay, Converter={StaticResource displayConvert}}" AutomationProperties.Name="安装包下载进度"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="BtnCheckUpdate" Content="检测更新" Click="BtnCheckUpdate_Click" IsEnabled="{x:Bind updateVM.CanCheck, Mode=OneWay}" Style="{StaticResource PageActionButtonStyle}"/>
                            <Button x:Name="BtnDownloadUpdate" Content="下载安装包" Click="BtnDownloadUpdate_Click" Visibility="{x:Bind updateVM.HideDownload, Mode=OneWay, Converter={StaticResource displayConvert}}" Style="{StaticResource PageActionButtonStyle}"/>
                            <Button x:Name="BtnInstallUpdate" Content="启动安装器并退出" Click="BtnInstallUpdate_Click" Visibility="{x:Bind updateVM.HideInstall, Mode=OneWay, Converter={StaticResource displayConvert}}" Style="{StaticResource PageActionButtonStyle}"/>
                            <Button x:Name="BtnCancelUpdate" Content="取消" Click="BtnCancelUpdate_Click" Visibility="{x:Bind updateVM.HideCancel, Mode=OneWay, Converter={StaticResource displayConvert}}" Style="{StaticResource PageActionButtonStyle}"/>
                        </StackPanel>
                    </Grid>


                    </StackPanel>
                    </Border>
                                    </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>