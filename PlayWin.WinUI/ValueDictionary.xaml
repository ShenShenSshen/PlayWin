<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PlatformSelectedBrush" Color="#1768B3" />
            <SolidColorBrush x:Key="PlatformSelectedHoverBrush" Color="#2174BD" />
            <SolidColorBrush x:Key="PlatformSelectedPressedBrush" Color="#164778" />
            <SolidColorBrush x:Key="PlatformSelectedForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ReadableSecondaryTextBrush" Color="#4B5563" />
            <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#EEF1F5" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardOutlineBrush" Color="#C5CFDC" />
            <Color x:Key="CategorySelectedColor">#DCEBFA</Color>
            <Color x:Key="CategorySelectedTextColor">#174E80</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PlatformSelectedBrush" Color="#1768B3" />
            <SolidColorBrush x:Key="PlatformSelectedHoverBrush" Color="#2174BD" />
            <SolidColorBrush x:Key="PlatformSelectedPressedBrush" Color="#164778" />
            <SolidColorBrush x:Key="PlatformSelectedForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ReadableSecondaryTextBrush" Color="#C4CBD4" />
            <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#10000000" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#181B20" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#22262C" />
            <SolidColorBrush x:Key="CardOutlineBrush" Color="#435061" />
            <Color x:Key="CategorySelectedColor">#253E59</Color>
            <Color x:Key="CategorySelectedTextColor">#E4F0FF</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PlatformSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PlatformSelectedHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PlatformSelectedPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PlatformSelectedForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ReadableSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardOutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <StaticResource x:Key="CategorySelectedColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="CategorySelectedTextColor" ResourceKey="SystemColorHighlightTextColor" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <AcrylicBrush x:Key="PlayerControlsBrush" TintColor="#202020" TintOpacity="0.7" FallbackColor="#E6202020" />
    <SolidColorBrush x:Key="CategorySelectedBrush" Color="{ThemeResource CategorySelectedColor}" />
    <SolidColorBrush x:Key="CategorySelectedForegroundBrush" Color="{ThemeResource CategorySelectedTextColor}" />
    <SolidColorBrush x:Key="SelectorBarItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
    <StaticResource x:Key="SelectorBarItemBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
    <StaticResource x:Key="SelectorBarItemBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush" />
    <Style x:Key="SelectorBarItemPill" TargetType="Rectangle">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <Style x:Key="PlatformItemStyle" TargetType="SelectorBarItem">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style x:Key="PlatformTabStyle" TargetType="ListViewItem">
        <Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="4"/>
        <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="32"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
            <primitives:ListViewItemPresenter CornerRadius="{TemplateBinding CornerRadius}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentMargin="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}" Background="Transparent"
                SelectedBackground="{ThemeResource PlatformSelectedBrush}" SelectedPointerOverBackground="{ThemeResource PlatformSelectedHoverBrush}" SelectedPressedBackground="{ThemeResource PlatformSelectedPressedBrush}" SelectedForeground="{ThemeResource PlatformSelectedForegroundBrush}"
                PointerOverBackground="{ThemeResource ControlFillColorSecondaryBrush}" PressedBackground="{ThemeResource ControlFillColorTertiaryBrush}" FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}" FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"/>
        </ControlTemplate></Setter.Value></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!--  GridView宽高  -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="ToolbarIconStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <x:Double x:Key="GridViewDesiredWidth">260.0</x:Double>
    <x:Double x:Key="GridViewItemHeight">196.0</x:Double>
</ResourceDictionary>
