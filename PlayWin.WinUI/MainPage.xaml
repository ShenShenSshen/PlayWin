<Page
    x:Class="PlayWin.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PlayWin.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <Thickness x:Key="NavigationViewContentPresenterMargin">0,0,0,0</Thickness>
        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">20</x:Double>
        <Style TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style TargetType="muxc:NavigationViewItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </Page.Resources>
    <Grid>


        <muxc:NavigationView
            x:Name="navigationView"
            Background="{ThemeResource ChromeSurfaceBrush}"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsSettingsVisible="true"
            Loaded="navigationView_Loaded"
            CompactPaneLength="56"
            OpenPaneLength="200"
            PaneDisplayMode="Left"
            SelectionChanged="NavigationView_SelectionChanged">
            <muxc:NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="searchBox"
                    AutomationProperties.Name="Search"
                    PlaceholderText="链接跳转或关键字搜索"
                    QueryIcon="Find"
                    QuerySubmitted="searchBox_QuerySubmitted" />
            </muxc:NavigationView.AutoSuggestBox>


            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem
                    Content="游戏直播"
                    IsSelected="True"
                    Tag="RecomendPage">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE10F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="游戏分类" Tag="CategoryPage">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE74C;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="关注" Tag="FavoritePage">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xEB51;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="历史" Tag="HistoryPage">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE121;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                
                <!--<muxc:NavigationViewItem Content="设置" Tag="SettingsPage">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE115;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>-->
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="frame" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
        </muxc:NavigationView>

    </Grid>
</Page>
